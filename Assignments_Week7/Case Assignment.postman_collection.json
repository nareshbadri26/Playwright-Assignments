      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let caseResponse = pm.response.json();\n\nlet caseID = caseResponse.id;\n\nconsole.log(caseID);\n\npm.collectionVariables.set(\"Case ID\", caseID);\n\npm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Response has an ID\", function () {\n    pm.expect(caseResponse).to.have.property(\"id\");\n    pm.expect(caseResponse.id).to.not.be.null;\n});\n\npm.test(\"Response indicates success\", function () {\n    pm.expect(caseResponse.success).to.be.true;\n});"
            ]
          }
        }
      ],
